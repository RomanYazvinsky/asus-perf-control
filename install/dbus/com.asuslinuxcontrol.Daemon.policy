<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ASUS Linux Control</vendor>
  <vendor_url>https://github.com/asus-linux-control</vendor_url>

  <action id="com.asuslinuxcontrol.set-temp-limit">
    <description>Set CPU temperature limit</description>
    <message>Authentication is required to change the CPU temperature limit</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.asuslinuxcontrol.manage-fan-engine">
    <description>Manage dynamic fan engine</description>
    <message>Authentication is required to start, stop, or update the dynamic fan engine</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.asuslinuxcontrol.set-cpu-boost-mode">
    <description>Set CPU boost mode</description>
    <message>Authentication is required to change the CPU boost mode</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="com.asuslinuxcontrol.manage-updates">
    <description>Install ASUS Linux Control package updates</description>
    <message>Authentication is required to install ASUS Linux Control package updates</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
