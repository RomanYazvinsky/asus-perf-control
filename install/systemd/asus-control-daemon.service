[Unit]
Description=ASUS Linux Control daemon
After=dbus.service asusd.service tuned.service tuned-ppd.service power-profiles-daemon.service

[Service]
Type=dbus
BusName=com.asuslinuxcontrol.Daemon
ExecStart=/usr/lib/asus-linux-control/asus-control-daemon
Restart=on-failure
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
