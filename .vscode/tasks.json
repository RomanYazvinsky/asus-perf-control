{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build UI",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}/rust_ui"
      },
      "problemMatcher": ["$rustc"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Build Rust Daemon",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--release"],
      "options": {
        "cwd": "${workspaceFolder}/rust_daemon"
      },
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      "label": "Run UI",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--release"],
      "options": {
        "cwd": "${workspaceFolder}/rust_ui"
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Test All",
      "type": "shell",
      "command": "make",
      "args": ["test"],
      "problemMatcher": ["$rustc"],
      "group": "test"
    },
    {
      "label": "Check Daemon Installation",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/check-daemon.sh",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Build and Check All",
      "dependsOn": ["Build UI", "Check Daemon Installation"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Clean All",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "problemMatcher": []
    }
  ]
}
